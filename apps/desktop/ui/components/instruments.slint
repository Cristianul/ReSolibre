import { Theme } from "theme.slint";
// Explicit antialiased circular geometry keeps small caps smooth at both native scales.
component SmoothDisc inherits Path {
    anti-alias: true;
    viewbox-width: 100; viewbox-height: 100;
    MoveTo { x: 50; y: 0; }
    ArcTo { x: 50; y: 100; radius-x: 50; radius-y: 50; sweep: true; }
    ArcTo { x: 50; y: 0; radius-x: 50; radius-y: 50; sweep: true; }
    Close { }
}

// Concentric front-facing caps: shallow rims, no offset underside or subpixel machining rings.
export component HardwareFace inherits Rectangle {
    in property <bool> silver: false;
    in property <bool> machined: false;
    in property <bool> pressed: false;
    in property <bool> hovered: false;
    border-radius: min(self.width, self.height) / 2;
    SmoothDisc { width: parent.width; height: parent.height; fill: #0e1112; }
    SmoothDisc {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        fill: Theme.bevel;
    }
    SmoothDisc {
        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
        fill: root.pressed ? Theme.key-down : root.silver ? Theme.silver : root.machined ? Theme.dark-metal : root.hovered ? Theme.raised : Theme.button;
    }
}

// Shallow key caps retain a fine socket; pressing changes lighting rather than perspective.
export component KeyFace inherits Rectangle {
    in property <bool> pressed;
    in property <bool> hovered;
    in property <bool> latched;
    in property <bool> subtle;
    border-radius: 4px;
    background: #111517;
    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        border-radius: 3px;
        background: Theme.key-edge;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: 2px;
            background: root.pressed || root.latched ? Theme.key-down : Theme.key-cap;
            opacity: root.subtle && !root.hovered ? 0.9 : 1;
        }
    }
}

// Shared recessed display glass for metadata and the queue, without pointer handling or bitmap assets.
export component ReadoutSurface inherits Rectangle {
    border-radius: 6px;
    background: @linear-gradient(180deg, #0b0f10 0%, #0b0f10 70%, #515a5c 100%);
    Rectangle {
        x: 1px; y: 2px; width: parent.width - 2px; height: parent.height - 3px;
        border-radius: 5px;
        background: @linear-gradient(155deg, #111a1c 0%, #192326 45%, #101719 100%);
        border-width: 1px; border-color: #050a0b;
    }
}

// Bounded arc geometry serves the continuous green ring and each colored segment.
component DialArc inherits Path {
    in property <angle> start-angle: -225deg;
    in property <float> span: 270;
    private property <angle> end-angle: root.start-angle + root.span * 1deg;
    viewbox-width: 100; viewbox-height: 100;
    anti-alias: true;
    stroke-width: 4px;
    MoveTo { x: 50 + cos(root.start-angle) * 44; y: 50 + sin(root.start-angle) * 44; }
    ArcTo {
        x: 50 + cos(root.end-angle) * 44; y: 50 + sin(root.end-angle) * 44;
        radius-x: 44; radius-y: 44; large-arc: root.span > 180; sweep: true;
    }
}

// Passive dial face with a physical pointer showing the current volume.
export component DialFace inherits Rectangle {
    in property <float> fraction;
    in property <bool> spectrum;
    in property <bool> focused;
    private property <length> diameter: min(root.width, root.height);
    Rectangle {
        width: root.diameter; height: root.diameter;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        border-radius: self.width / 2; background: #080a0b;
        border-width: 1px; border-color: #303536;
        DialArc { stroke: #373c3d; }
        if !root.spectrum && root.fraction > 0: DialArc { stroke: Theme.accent; span: root.fraction * 270; }
        for index in (root.spectrum ? 10 : 0): Rectangle {
            if root.fraction * 10 > index: DialArc {
                start-angle: -225deg + index * 27deg;
                span: min(1, root.fraction * 10 - index) * 24;
                stroke: Theme.band-color(index, true);
            }
        }
    }
    HardwareFace {
        machined: true;
        x: (root.width - self.width) / 2; y: (root.height - self.height) / 2;
        width: root.diameter - 14px; height: self.width;
        border-width: root.focused ? 1px : 0px; border-color: Theme.focus;
        Path {
            private property <angle> angle: -225deg + root.fraction * 270deg;
            viewbox-width: 100; viewbox-height: 100;
            stroke: root.spectrum ? Theme.text : Theme.accent; stroke-width: 4px;
            MoveTo { x: 50 + cos(parent.angle) * 29; y: 50 + sin(parent.angle) * 29; }
            LineTo { x: 50 + cos(parent.angle) * 40; y: 50 + sin(parent.angle) * 40; }
        }
    }
}

// Recessed rails and slim metal caps; the shared slider still owns all gesture math.
export component LinearSliderFace inherits Rectangle {
    in property <bool> spectrum: false;
    in property <float> mix-start: 0;
    in property <float> mix-end: 0;
    in property <float> skipped-start: 0;
    in property <float> skipped-end: 1;
    in property <bool> vertical;
    in property <bool> focused;
    in property <float> fraction;
    in property <color> accent: Theme.accent;
    in property <bool> fill-track: true;
    if root.vertical: Rectangle {
        for index in 13: Rectangle {
            x: 3px;
            y: 13px + index * (parent.height - 26px) / 12;
            width: parent.width - 6px; height: 1px;
            background: index == 6 ? #727976 : index == 0 || index == 12 ? #454d4b : #333b39;
        }
    }
    Rectangle {
        x: root.vertical ? (parent.width - 9px) / 2 : 8px;
        y: root.vertical ? 6px : (parent.height - 8px) / 2;
        width: root.vertical ? 9px : parent.width - 16px;
        height: root.vertical ? parent.height - 12px : 8px;
        border-radius: 4px; background: #030506;
        border-width: 1px; border-color: #393e3e;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: 3px; background: @linear-gradient(180deg, #020303 0%, #101414 100%);
        }
    }
    if root.fill-track: Rectangle {
        x: root.vertical ? (parent.width - 4px) / 2 : 10px;
        y: root.vertical ? 13px + (parent.height - 26px) * (1 - root.fraction) : (parent.height - 4px) / 2;
        width: root.vertical ? 4px : max(0px, (parent.width - 20px) * root.fraction);
        height: root.vertical ? max(0px, parent.height - 8px - self.y) : 4px;
        border-radius: 2px;
        background: root.spectrum && !root.vertical ? Theme.spectrum-progress : root.accent;
    }
    // Overlay only excluded source intervals; cursor and hit testing retain the original timeline.
    if !root.vertical && root.skipped-start > 0: Rectangle {
        x: 10px; y: (parent.height - 4px) / 2;
        width: max(0px, parent.width - 20px) * clamp(root.skipped-start, 0, 1); height: 4px;
        border-radius: 2px; background: Theme.skipped;
    }
    if !root.vertical && root.skipped-end < 1: Rectangle {
        x: 10px + max(0px, parent.width - 20px) * clamp(root.skipped-end, 0, 1);
        y: (parent.height - 4px) / 2;
        width: max(0px, parent.width - 20px) * (1 - clamp(root.skipped-end, 0, 1)); height: 4px;
        border-radius: 2px; background: Theme.skipped;
    }
    // Static texture distinguishes the real overlap from yellow excluded edges.
    if !root.vertical && root.mix-end > root.mix-start: mix-range := Rectangle {
        x: 10px + max(0px, root.width - 20px) * clamp(root.mix-start, 0, 1);
        y: (root.height - 4px) / 2;
        width: max(0px, root.width - 20px) * (clamp(root.mix-end, 0, 1) - clamp(root.mix-start, 0, 1));
        height: 4px; background: Theme.mix-region; clip: true;
        for index in min(512, ceil(mix-range.width / 6px)): Path {
            x: index * 6px; y: 0px; width: 4px; height: 4px;
            viewbox-width: 4; viewbox-height: 4; fill: Theme.mix-hatch;
            commands: "M 2 0 L 4 0 L 2 4 L 0 4 Z";
        }
    }
    if !root.vertical && root.mix-end > root.mix-start: Rectangle {
        x: 9px + max(0px, root.width - 20px) * clamp(root.mix-start, 0, 1);
        y: (root.height - 12px) / 2;
        width: 2px; height: 12px; background: Theme.mix-region;
    }
    if !root.vertical && root.mix-end > root.mix-start: Rectangle {
        x: 9px + max(0px, root.width - 20px) * clamp(root.mix-end, 0, 1);
        y: (root.height - 12px) / 2;
        width: 2px; height: 12px; background: Theme.mix-region;
    }
    Rectangle {
        x: root.vertical ? (parent.width - 18px) / 2 : 2px + (parent.width - 16px) * root.fraction;
        y: root.vertical ? (parent.height - 26px) * (1 - root.fraction) : (parent.height - 12px) / 2;
        width: root.vertical ? 18px : 12px; height: root.vertical ? 26px : 12px;
        border-radius: root.vertical ? 3px : 6px;
        background: #060809;
        Rectangle {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            border-radius: root.vertical ? 2px : 5px;
            background: Theme.fader;
            border-width: 1px; border-color: root.focused ? Theme.focus : #d0d3d1;
            if root.vertical: Rectangle {
                x: 2px; y: (parent.height - 4px) / 2; width: parent.width - 4px; height: 4px;
                border-radius: 1px; background: #373c39;
                Rectangle { x: 1px; y: 1px; width: parent.width - 2px; height: 2px; background: root.accent; }
            }
        }
    }
}

// Square current cover with centered fill; the bundled illustration remains the explicit fallback.
export component CollectionArtwork inherits Rectangle {
    in property <image> artwork;
    in property <bool> has-cover;
    in property <bool> loading;
    background: Theme.recess; border-radius: Theme.window-radius;
    border-color: Theme.rim; border-width: 1px;
    clip: true;
    accessible-role: image;
    accessible-label: root.loading ? @tr("Loading album cover") : root.has-cover ? @tr("Album cover") : @tr("Collection illustration");
    Image {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        source: root.has-cover ? root.artwork : @image-url("../assets/forest-artwork.png");
        accessible-role: none;
        image-fit: cover;
    }
    Rectangle {
        visible: !root.has-cover;
        y: root.height - 48px; height: 48px;
        background: @linear-gradient(180deg, #0b181000 0%, #0b1810e8 100%);
    }
    Text {
        visible: !root.has-cover;
        x: 12px; y: root.height - 31px; width: root.width - 24px; height: 20px;
        text: "R E S O U L"; color: #e5f0e6; font-size: 10px;
        vertical-alignment: center;
    }
}
