import { Theme } from "theme.slint";
import { ActionButton } from "controls.slint";
import { BrandLogo } from "branding.slint";

// Shared front-facing chassis: a fine lip and shallow sidewall inside the window.
export component WindowSurface inherits Rectangle {
    background: Theme.window-bevel;
    border-radius: Theme.window-radius;
    Rectangle {
        x: 1px; y: 1px;
        width: parent.width - 2px; height: parent.height - 2px;
        border-radius: Theme.window-radius - 1px;
        background: Theme.case-side;
    }
    Rectangle {
        x: 2px; y: 2px;
        width: parent.width - 4px; height: parent.height - 4px;
        border-radius: 4px;
        background: Theme.faceplate;
        border-width: 1px; border-color: #ffffff06;
        // Fixed faint machining lines give the shell a material without textures or idle work.
        for index in 64: Rectangle {
            x: 2px; y: 4px + index * (parent.height - 8px) / 64;
            width: parent.width - 4px; height: 0.5px;
            background: #ffffff02;
        }
    }

}

// A recessed module with a rolled top lip; the drawer remains part of the main chassis.
export component DrawerSurface inherits Rectangle {
    border-radius: 7px;
    background: @linear-gradient(180deg, #090c0e 0%, #121719 70%, #4b5255 100%);
    Rectangle {
        x: 1px; y: 4px; width: parent.width - 2px; height: parent.height - 5px;
        border-radius: 6px; background: Theme.drawer;
        border-width: 1px; border-color: #ffffff08;
    }
    Rectangle {
        x: 8px; y: 3px; width: parent.width - 16px; height: 5px;
        border-radius: 2px;
        background: @linear-gradient(180deg, #62696c 0%, #3d4447 28%, #252b2e 100%);
    }
}

// A narrower chassis tucked behind the main case, with no exposed rails or gap.
export component PulloutDrawer inherits Rectangle {
    WindowSurface { }
    Rectangle {
        x: 5px; y: 6px; width: parent.width - 10px; height: 5px;
        background: @linear-gradient(180deg, #00000050 0%, #00000000 100%);
    }
    Rectangle {
        x: (parent.width - self.width) / 2; y: parent.height - 9px;
        width: 38px; height: 3px; border-radius: 1px;
        background: #0d1214;
        Rectangle { y: 2px; height: 1px; background: #ffffff18; }
    }
}

// Native movement for passive surfaces; controls placed above it keep their gestures.
export component WindowDragArea inherits WindowMoveArea {
    in property <bool> movable: true;
    out property <bool> hovered: touch.has-hover;
    callback begin-group-move() -> bool;
    callback update-group-move();
    callback end-group-move();
    private property <bool> group-moving;
    enabled: root.movable && !root.group-moving;
    touch := TouchArea {
        enabled: root.movable;
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                root.group-moving = root.begin-group-move();
            }
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) || event.kind == PointerEventKind.cancel {
                if root.group-moving { root.end-group-move(); }
                root.group-moving = false;
            }
        }
        moved => { if root.group-moving { root.update-group-move(); } }
    }
    @children
}

// Shared window chrome; toolbar controls retain independent gestures.
export component WindowHeader inherits Rectangle {
    in property <string> title: "ReSolibre";
    in property <bool> enabled: true;
    in property <bool> maximized;
    in property <bool> show-window-actions: true;
    in property <string> close-label: @tr("Close player");
    callback minimize();
    callback toggle-maximize();
    callback request-close();
    callback begin-group-move() -> bool;
    callback update-group-move();
    callback end-group-move();
    height: 26px;
    accessible-role: window-title-bar;
    accessible-label: root.title;
    HorizontalLayout {
        spacing: 4px;
        WindowDragArea {
            movable: root.enabled;
            min-width: 86px;
            horizontal-stretch: 1;
            begin-group-move => { root.begin-group-move() }
            update-group-move => { root.update-group-move(); }
            end-group-move => { root.end-group-move(); }
            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 26px;
                    BrandLogo { y: (parent.height - self.height) / 2; }
                }
                Text { text: root.title; font-size: 12px; font-weight: 600; letter-spacing: 1px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
            }
        }
        @children
        if root.show-window-actions: ActionButton { width: 26px; compact: true; quiet: true; label: @tr("Minimize window"); icon: @image-url("../assets/minus.svg"); enabled: root.enabled; clicked => { root.minimize(); } }
        if root.show-window-actions: ActionButton { width: 26px; compact: true; quiet: true; label: root.maximized ? @tr("Restore window") : @tr("Maximize window"); icon: root.maximized ? @image-url("../assets/copy.svg") : @image-url("../assets/square.svg"); enabled: root.enabled; clicked => { root.toggle-maximize(); } }
        ActionButton { width: 26px; compact: true; quiet: true; label: root.close-label; icon: @image-url("../assets/x.svg"); enabled: root.enabled; clicked => { root.request-close(); } }
    }
}
